# Chave da API do Google Gemini (crie em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo do Gemini usado na classificação
GEMINI_MODEL=gemini-3.8-flash
# E-mail que recebe as mensagens classificadas (usado pelo fluxo n8n)
EMAIL_DESTINO=
# Fuso horário do n8n
GENERIC_TIMEZONE=America/Sao_Paulo
# Conta Gmail que envia os e-mails (a mesma usada na credencial SMTP do n8n)
EMAIL_REMETENTE=
