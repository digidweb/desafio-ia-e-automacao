            "index": 0
          }
        ]
      ]
    },
    "Edit Fields - Montar e-mail": {
      "main": [
        [
          {
            "node": "Send Email - Encaminhar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email - Encaminhar": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
